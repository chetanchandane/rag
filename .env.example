# ── LLM & Embeddings ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
# Get these from: https://cloud.qdrant.io → your cluster → API keys
QDRANT_URL=https://xxxx.us-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=clinical_docs

# ── LangSmith ─────────────────────────────────────────────────────────────────
# Get from: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=clinical-rag
