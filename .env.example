# ── LLM & Embeddings ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
# Get these from: https://cloud.qdrant.io → your cluster → API keys
QDRANT_URL=https://xxxx.us-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=clinical_docs

# ── LangSmith ─────────────────────────────────────────────────────────────────
# Get from: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=clinical-rag

# --- Cohere API Key ---
COHERE_API_KEY=your_cohere_api_key

# ── Postgres (Phase 3: relational backend) ────────────────────────────────────
# Ingestion/migrations use the OWNER role (write). The app query path should use
# a separate READ-ONLY role. Never commit real URLs.
#   Render: copy the External URL for local ingestion, the Internal URL for the service.

# ── openFDA (optional) ────────────────────────────────────────────────────────
# No key needed for low volume. A free key raises rate limits: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=wjTEjFVaXlUWcs1bs6E5vgBg6NOi8sBrz52thisisanexamplekey

DATABASE_URL=postgresql://user:password@host:5432/dbname
# Read-only role for the app query path. Generate with: python -m src.sql.setup_readonly_role
DATABASE_URL_RO=postgresql://clinrag_readonly:password@host:5432/dbname